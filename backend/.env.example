PORT=5000
NODE_ENV=development

# REQUIRED secrets - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_PEPPER=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (no wildcard)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Firebase web API key (phone OTP verification)
FIREBASE_API_KEY=

# Email (SMTP / Resend / Brevo)
EMAIL_PROVIDER=smtp
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
BREVO_API_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Vision API Key
GEMINI_API_KEY=

# Storage Config
STORAGE_TYPE=local
STORAGE_DIR=./uploads

# Database URL (Optional PostgreSQL connection)
DATABASE_URL=

# Demo ADMIN/CA/CUSTOMER accounts are only seeded outside production,
# or in production when this is set explicitly. Never reuse a real password.
SEED_ADMIN_PASSWORD=
